# -- Font --
font-family = "JetBrainsMono Nerd Font Mono"
font-size = 17
font-thicken = true
adjust-cell-height = 10%
font-feature = -calt

# -- Appearance --
title = " "
adjust-cursor-thickness = 4
macos-titlebar-style = transparent
macos-titlebar-proxy-icon = hidden

theme = dark:Rose Pine,light:Rose Pine Dawn
