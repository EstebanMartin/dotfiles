[core]
	editor = nvim
	# Cache the untracked-file scan in the index so `git status` (and the shell prompt)
	# stays fast in big repos; bare-layout clones (wt clone) get no per-repo setting
	untrackedCache = true

[advice]
	# Suppress the "skipped cherry pick" warning during rebases
	skippedCherryPicks = false

[user]
	name = Esteban Ramirez
	email = 6530285+EstebanMartin@users.noreply.github.com
	# Public half of the SSH key in 1Password; override in config.local for a different key
	signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIBA054wZte0l5xLqpx2KjcM8glUMRL+l1FYwbtI/ydtW

[commit]
	# Sign every commit with the SSH key above
	gpgsign = true

	# Show the diff being committed below the message in the editor
	verbose = true

[gpg]
	format = ssh

[gpg "ssh"]
	# 1Password signs with the key without it ever leaving the vault
	program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign

[url "ssh://git@github.com/"]
	# Always use SSH instead of HTTPS for GitHub
	insteadOf = https://github.com/

# Replaces large files in the repo with text pointers, storing the actual content on a separate server
[filter "lfs"]
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f

[init]
	defaultBranch = master

[merge]
	# Like diff3 but cleaner — shows base content in conflict markers
	conflictstyle = zdiff3

[diff]
	# Highlight moved blocks of code differently from added/removed lines
	colorMoved = default

	# Ignores whitespace/indentation shifts when tracking moved code
	colorMovedWS = allow-indentation-change

	# Diff algorithm that aligns on unique lines, giving more readable hunks
	algorithm = histogram

[interactive]
	# Instantly accepts staging choices without needing to press Enter
	singleKey = true

[rerere]
	# Remember conflict resolutions and replay them automatically
	enabled = true

[rebase]
	# Stash uncommitted changes before rebase, restore after
	autoStash = true

	# Automatically update dependent branches during rebase (requires Git 2.38+)
	updateRefs = true

[branch]
	# Show most recently committed branches first
	sort = -committerdate

[pull]
	rebase = true

[fetch]
	# Remove remote-tracking branches that no longer exist on the remote
	prune = true

	# Automatically delete local tags that were removed from the remote
	pruneTags = true

[push]
	# Automatically set upstream when pushing a new branch
	autoSetupRemote = true

[help]
	# Suggest a correction on typos and ask before running it
	autocorrect = prompt

[tag]
	# Sort by version number instead of lexicographically (v1.2 before v1.10)
	sort = version:refname

[alias]
	start = "!f() { \
		remote=$(git remote | grep -E '^(upstream|canonical)$' | head -1); \
		remote=${remote:-origin}; \
		git fetch -p \"$remote\" && \
		git switch -c \"$1\" \"$remote/HEAD\" && \
		git push -u origin \"$1\"; \
	}; f"
	save = "!f() { \
		git add -A && \
		git commit -m \"${1:-CHECKPOINT}\"; \
	}; f"
	resume = reset HEAD~1
	root = rev-parse --show-toplevel

# Machine-specific overrides (e.g. work email), untracked via the *.local.* ignore rule; last so it wins
[include]
	path = ~/.config/git/config.local
