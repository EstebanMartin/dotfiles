# Hand-edited theme, based on fish's Simple theme. Edit this file directly; `fish_config theme choose` would overwrite it.
set --global fish_color_normal normal
set --global fish_color_command blue --bold
set --global fish_color_keyword magenta
set --global fish_color_param normal
set --global fish_color_option cyan
set --global fish_color_quote normal
set --global fish_color_redirection cyan
set --global fish_color_end yellow --bold
set --global fish_color_operator yellow --bold
set --global fish_color_escape cyan
set --global fish_color_error red
set --global fish_color_comment brblack
set --global fish_color_autosuggestion brblack
set --global fish_color_valid_path magenta --underline
set --global fish_color_cwd cyan
set --global fish_color_cwd_root red
set --global fish_color_user green
set --global fish_color_host normal
set --global fish_color_host_remote yellow
set --global fish_color_status red
set --global fish_color_cancel --reverse
set --global fish_color_history_current --bold
set --global fish_color_search_match --background=brblack
set --global fish_color_selection --background=brblack
set --global fish_pager_color_progress brblack
set --global fish_pager_color_prefix cyan --underline
set --global fish_pager_color_completion normal
set --global fish_pager_color_description brblack
set --global fish_pager_color_selected_background --background=brblack
