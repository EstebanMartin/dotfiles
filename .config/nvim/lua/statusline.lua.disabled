-- Statusline format string helper; vim requires %#Group# for highlights.
---@param group string
---@return string
local sl_hl = function(group)
    return "%#" .. group .. "#"
end

-- Resolves a highlight group without following links, so we can read
-- raw fg/bg values to derive colors from the active colorscheme.
---@param group string
---@return vim.api.keyset.get_hl_info
local get_hl = function(group)
    return vim.api.nvim_get_hl(0, { name = group, link = false, create = false })
end

-- Derives statusline colors from the active colorscheme rather than
-- hardcoding them, so the statusline adapts when the theme changes.
local set_hl_groups = function()
    ---@type table<string, vim.api.keyset.highlight>
    local statusline_groups = {
        -- Mode colors invert the statusline fg/bg for a block-style pill.
        StatusLineModeNormal  = { fg = get_hl("StatusLine").bg, bg = get_hl("StatusLine").fg },
        StatusLineModePending = { fg = get_hl("StatusLine").bg, bg = get_hl("Comment").fg },
        StatusLineModeVisual  = { fg = get_hl("StatusLine").bg, bg = get_hl("SpecialKey").fg },
        StatusLineModeInsert  = { fg = get_hl("StatusLine").bg, bg = get_hl("diffAdded").fg },
        StatusLineModeCommand = { fg = get_hl("StatusLine").bg, bg = get_hl("Number").fg },
        StatusLineModeReplace = { fg = get_hl("StatusLine").bg, bg = get_hl("Constant").fg },
        StatusLineModeOther   = { link = "StatusLine" },
        StatusLineBold        = { bold = true },
        -- Reuse LineNr for dimmed text; typically muted in most themes.
        StatusLineDim         = { fg = get_hl("LineNr").fg },
        StatusLineDimItalic   = { fg = get_hl("LineNr").fg, italic = true },
        StatusLineInverted    = { link = "StatusLineModeNormal" },
        -- Use a warning color for the modified indicator.
        StatusLineModified    = { fg = get_hl("DiagnosticWarn").fg },
    }

    for group, opts in pairs(statusline_groups) do
        vim.api.nvim_set_hl(0, group, opts)
    end
end

set_hl_groups()

-- Colors are derived at load time, so re-derive them whenever the
-- colorscheme changes or they'll refer to the old theme's values.
vim.api.nvim_create_autocmd("ColorScheme", {
    group = vim.api.nvim_create_augroup("jscott/statusline_colors", { clear = true }),
    desc = "Re-apply statusline highlights on colorscheme change",
    callback = set_hl_groups,
})

-- vim sets statusline_winid to the window being rendered, which may
-- differ from the focused window. Use this instead of win_getid().
---@return number
local sl_winid = function()
    return vim.g.statusline_winid or 0
end

-- Components should read buffer options from the statusline window's
-- buffer, not the current buffer, to avoid stale data in inactive windows.
---@return number
local sl_bufnr = function()
    return vim.api.nvim_win_get_buf(sl_winid())
end

---@return string
local mode_component = function()
    -- Note that: \19 = ^S and \22 = ^V.
    -- stylua: ignore start
    local mode_settings = {
        ["n"]     = { name = "NORMAL", hl = "Normal" },
        ["no"]    = { name = "OP-PENDING", hl = "Pending" },
        ["nov"]   = { name = "OP-PENDING", hl = "Pending" },
        ["noV"]   = { name = "OP-PENDING", hl = "Pending" },
        ["no\22"] = { name = "OP-PENDING", hl = "Pending" },
        ["niI"]   = { name = "NORMAL", hl = "Normal" },
        ["niR"]   = { name = "NORMAL", hl = "Normal" },
        ["niV"]   = { name = "NORMAL", hl = "Normal" },
        ["nt"]    = { name = "NORMAL", hl = "Normal" },
        ["ntT"]   = { name = "NORMAL", hl = "Normal" },
        ["v"]     = { name = "VISUAL", hl = "Visual" },
        ["vs"]    = { name = "VISUAL", hl = "Visual" },
        ["V"]     = { name = "V-LINE", hl = "Visual" },
        ["Vs"]    = { name = "V-LINE", hl = "Visual" },
        ["\22"]   = { name = "V-BLOCK", hl = "Visual" },
        ["\22s"]  = { name = "V-BLOCK", hl = "Visual" },
        ["s"]     = { name = "SELECT", hl = "Insert" },
        ["S"]     = { name = "S-LINE", hl = "Normal" },
        ["\19"]   = { name = "S-BLOCK", hl = "Normal" },
        ["i"]     = { name = "INSERT", hl = "Insert" },
        ["ic"]    = { name = "INSERT", hl = "Insert" },
        ["ix"]    = { name = "INSERT", hl = "Insert" },
        ["R"]     = { name = "REPLACE", hl = "Replace" },
        ["Rc"]    = { name = "REPLACE", hl = "Replace" },
        ["Rx"]    = { name = "REPLACE", hl = "Replace" },
        ["Rv"]    = { name = "V-REPLACE", hl = "Replace" },
        ["Rvc"]   = { name = "V-REPLACE", hl = "Replace" },
        ["Rvx"]   = { name = "V-REPLACE", hl = "Replace" },
        ["c"]     = { name = "COMMAND", hl = "Command" },
        ["cv"]    = { name = "EX", hl = "Command" },
        ["ce"]    = { name = "EX", hl = "Command" },
        ["r"]     = { name = "REPLACE", hl = "Normal" },
        ["rm"]    = { name = "MORE", hl = "Normal" },
        ["r?"]    = { name = "CONFIRM", hl = "Normal" },
        ["!"]     = { name = "SHELL", hl = "Normal" },
        ["t"]     = { name = "TERMINAL", hl = "Command" },
    }
    -- stylua: ignore end

    local settings      = mode_settings[vim.api.nvim_get_mode().mode] or {}
    local mode          = settings.name or "UNKNOWN"
    local hl            = settings.hl or "Other"

    return sl_hl("StatusLineMode" .. hl) .. " " .. mode .. " "
end

-- gitsigns doesn't trigger a statusline redraw on its own; listen for
-- its update event and force one ourselves.
vim.api.nvim_create_autocmd("User", {
    pattern = "GitSignsUpdate",
    group = vim.api.nvim_create_augroup("jscott/statusline_gitsigns", { clear = true }),
    callback = function()
        vim.cmd.redrawstatus({ bang = true })
    end,
})

---@return string?
local git_component = function()
    local head = vim.b.gitsigns_head
    if not head or head == "" then return end

    local component = " " .. " " .. sl_hl("StatusLine") .. head

    -- Read hunk counts from the cached gitsigns buffer variable to
    -- avoid calling into gitsigns on every statusline render.
    local status = vim.b[sl_bufnr()].gitsigns_status_dict
    if status then
        local n_hunks = (status.added or 0)
            + (status.changed or 0)
            + (status.removed or 0)
        if n_hunks > 0 then
            local s = n_hunks == 1 and "" or "s"
            component = component
                .. sl_hl("StatusLineDimItalic")
                .. string.format(" (%d hunk%s)", n_hunks, s)
        end
    end

    return component
end

---@return string?
local dap_component = function()
    -- Guard against dap not being loaded to avoid a startup cost.
    if not package.loaded["dap"] or require("dap").status() == "" then
        return
    end

    return string.format("%%#%s#%s  %s", "Special", "", require("dap").status())
end

-- LSP progress events are async; cache the latest state here so the
-- render function can read it without doing work on each redraw.
---@type table<string, string?>
local progress_status = {
    client = nil,
    kind   = nil,
    title  = nil,
}

vim.api.nvim_create_autocmd("LspProgress", {
    group = vim.api.nvim_create_augroup("jscott/statusline", { clear = true }),
    desc = "Update LSP progress in statusline",
    pattern = { "begin", "end" },
    callback = function(args)
        if not args.data then return end

        progress_status = {
            client = vim.lsp.get_client_by_id(args.data.client_id).name,
            kind   = args.data.params.value.kind,
            title  = args.data.params.value.title,
        }

        if progress_status.kind == "end" then
            progress_status.title = nil
            -- Linger briefly so the "done" state is visible before clearing.
            vim.defer_fn(function()
                vim.cmd.redrawstatus({ bang = true })
            end, 3000)
        else
            vim.cmd.redrawstatus({ bang = true })
        end
    end,
})

---@return string?
local lsp_progress_component = function()
    if not progress_status.client or not progress_status.title then
        return
    end

    -- LSP completion noise in insert mode would make this flicker constantly.
    if vim.startswith(vim.api.nvim_get_mode().mode, "i") then
        return
    end

    return " "
        .. " "
        .. sl_hl("StatusLineDim")
        .. progress_status.client
        .. ": "
        .. sl_hl("StatusLineDimItalic")
        .. progress_status.title
end

---@return string
local diagnostic_component = function()
    return (vim.diagnostic.status(sl_bufnr())
        :gsub("%w+:", " %0", 1)
        :gsub("(:%d+)%%", "%1 %%"))
end

---@return string?
local file_component = function()
    local buf      = sl_bufnr()
    local ft       = vim.bo[buf].filetype
    local buf_path = vim.api.nvim_buf_get_name(buf)
    local buf_name = vim.fn.fnamemodify(buf_path, ":t")

    -- Nothing meaningful to show for an unnamed buffer with no filetype.
    if ft == "" and buf_path == "" then return end

    local display_name = buf_name == "" and buf_path or buf_name

    return sl_hl("StatusLineBold") .. display_name
end

---@return string?
local modified_component = function()
    if vim.bo[sl_bufnr()].modified then
        return sl_hl("StatusLineModified") .. "[+]"
    end
end

-- Word/char counts are only shown for markdown; too noisy in code buffers.
---@return string
local wordcount_component = function()
    local wc     = vim.api.nvim_buf_call(sl_bufnr(), vim.fn.wordcount)
    local visual = vim.fn.mode():match("^[vV\22]")

    return sl_hl("StatusLineDim")
        .. " "
        .. string.format("%s%sw", visual and wc.visual_words .. "/" or "", wc.words)
        .. " "
        .. string.format("%s%sc", visual and wc.visual_chars .. "/" or "", wc.chars)
        .. " "
end

---@return string
local position_component = function()
    return sl_hl("StatusLineInverted")
        .. string.format(" %2d:%-2d ", vim.fn.line("."), vim.fn.virtcol("."))
end

-- Exposed as a global so vim's `%!v:lua.statusline.render()` can call it.
_G.statusline = {}

---@return string
function statusline.render()
    local win_is_active = sl_winid() == vim.fn.win_getid()

    -- Show a minimal statusline for inactive windows to reduce visual noise.
    if not win_is_active then
        local file = file_component()
        return file and " " .. file or ""
    end

    local ft    = vim.bo[sl_bufnr()].filetype
    local sep   = sl_hl("StatusLine") .. " "

    -- Split into left/right to avoid the separator wrapping around %=.
    local left  = vim.iter({
        mode_component(),
        file_component(),
        modified_component(),
        " ",
        dap_component() or lsp_progress_component(),
    }):flatten():totable()

    local right = vim.iter({
        diagnostic_component(),
        ft == "markdown" and wordcount_component() or "",
        git_component(),
        position_component(),
    }):flatten():totable()

    return table.concat(left, sep) .. "%=" .. table.concat(right, sep)
end

vim.opt.statusline = "%!v:lua.statusline.render()"
