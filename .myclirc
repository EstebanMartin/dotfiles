# vi: ft=dosini
# Only overrides; mycli's built-in myclirc provides every other default.
[main]

# statements end at ";" instead of Enter, so they can span lines
multi_line = True
key_bindings = vi
# no intro/outro text
less_chatty = True
# switch to vertical output when a result is too wide for the window
auto_vertical_output = True
keyword_casing = upper
# plain-text tables, easy to paste elsewhere
table_format = ascii

# no fixed colors; [colors] below uses ANSI names instead
syntax_style = bw

[colors]
# ANSI names follow the terminal palette, so these switch with light/dark mode
sql.keyword = 'bold ansigreen'
sql.datatype = 'ansiblue'
sql.function = 'ansicyan'
sql.string = 'ansiyellow'
sql.number = 'ansiyellow'
sql.comment = 'italic ansibrightblack'
sql.operator = 'ansibrightblack'
output.header = 'bold ansiblue'
output.null = 'ansibrightblack'
