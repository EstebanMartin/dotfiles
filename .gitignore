# SSH: keys, host lists and config stay per machine
.ssh/

# Per-machine state written by tools
.config/fish/fish_variables
.config/gh/hosts.yml
.config/nvim/nvim-pack-lock.json
.mycli-history
.mycli.log
.claude.json
.claude.json.backup*

# Machine/work-specific overrides and private files, never committed
*.local
*.local.*
*.private
*.private.*
work/
local/

# macOS
.DS_Store

# The bare repo itself (git only skips folders named .git automatically)
.dotfiles/
